rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Helper Functions
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'nagorikeitsheba@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 3. Entity Validation Blueprints
    function isValidUser(data, userId) {
      return data.keys().hasAll([
          'uid', 'name', 'email', 'role', 'accountStatus',
          'subscriptionStatus', 'expiresAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'name', 'email', 'phone', 'photoURL', 'role', 'accountStatus',
          'subscriptionStatus', 'planId', 'planName', 'paymentMethod', 'senderNumber',
          'trxId', 'startDate', 'expiresAt', 'requestedAt', 'approvedAt', 'approvedBy',
          'freeScansLimit', 'freeScansUsed', 'dailyScansUsed', 'lastScanDate',
          'totalScansUsed', 'dailyScanLimit', 'customDailyScanLimit',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == userId
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 30))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && data.role in ['admin', 'user']
        && data.accountStatus in ['active', 'suspended', 'banned']
        && data.subscriptionStatus in ['ACTIVE', 'PENDING', 'EXPIRED', 'NONE']
        && (!('planId' in data) || (data.planId is string && data.planId.size() <= 50))
        && (!('planName' in data) || (data.planName is string && data.planName.size() <= 120))
        && (!('paymentMethod' in data) || (data.paymentMethod in ['bkash', 'nagad', 'rocket', 'binance', '']))
        && (!('senderNumber' in data) || (data.senderNumber is string && data.senderNumber.size() <= 80))
        && (!('trxId' in data) || (data.trxId is string && data.trxId.size() <= 100))
        && (!('startDate' in data) || data.startDate is number)
        && data.expiresAt is number
        && (!('requestedAt' in data) || data.requestedAt is number)
        && (!('approvedAt' in data) || data.approvedAt is number)
        && (!('approvedBy' in data) || (data.approvedBy is string && data.approvedBy.size() <= 200))
        && (!('freeScansLimit' in data) || (data.freeScansLimit is number && data.freeScansLimit >= 0 && data.freeScansLimit <= 10000))
        && (!('freeScansUsed' in data) || (data.freeScansUsed is number && data.freeScansUsed >= 0 && data.freeScansUsed <= 100000))
        && (!('dailyScansUsed' in data) || (data.dailyScansUsed is number && data.dailyScansUsed >= 0 && data.dailyScansUsed <= 100000))
        && (!('lastScanDate' in data) || (data.lastScanDate is string && data.lastScanDate.size() <= 20))
        && (!('totalScansUsed' in data) || (data.totalScansUsed is number && data.totalScansUsed >= 0))
        && (!('dailyScanLimit' in data) || (data.dailyScanLimit is number && data.dailyScanLimit >= 0 && data.dailyScanLimit <= 100000))
        && (!('customDailyScanLimit' in data) || (data.customDailyScanLimit is number && data.customDailyScanLimit >= -1 && data.customDailyScanLimit <= 100000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserScanIncrement() {
      let prevTotal = ('totalScansUsed' in existing()) ? existing().totalScansUsed : 0;
      let prevFreeUsed = ('freeScansUsed' in existing()) ? existing().freeScansUsed : 0;
      let prevFreeLimit = ('freeScansLimit' in existing()) ? existing().freeScansLimit : 5;
      let prevDailyUsed = ('dailyScansUsed' in existing()) ? existing().dailyScansUsed : 0;
      let prevDate = ('lastScanDate' in existing()) ? existing().lastScanDate : '';
      let customLimit = ('customDailyScanLimit' in existing()) ? existing().customDailyScanLimit : -1;
      let planLimit = ('dailyScanLimit' in existing()) ? existing().dailyScanLimit : 0;
      let effectiveDailyLimit = customLimit >= 0 ? customLimit : planLimit;
      let isPaidActive = existing().subscriptionStatus == 'ACTIVE' && existing().expiresAt > request.time.toMillis();

      return existing().accountStatus == 'active'
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'freeScansUsed', 'dailyScansUsed', 'lastScanDate', 'totalScansUsed', 'updatedAt'
        ])
        && incoming().totalScansUsed == prevTotal + 1
        && incoming().lastScanDate is string
        && incoming().lastScanDate.size() >= 8
        && incoming().lastScanDate.size() <= 20
        && (
          (
            isPaidActive
            && incoming().freeScansUsed == prevFreeUsed
            && (
              (incoming().lastScanDate != prevDate && incoming().dailyScansUsed == 1) ||
              (incoming().lastScanDate == prevDate && incoming().dailyScansUsed == prevDailyUsed + 1)
            )
            && (effectiveDailyLimit == 0 || incoming().dailyScansUsed <= effectiveDailyLimit)
          ) ||
          (
            !isPaidActive
            && prevFreeUsed < prevFreeLimit
            && incoming().freeScansUsed == prevFreeUsed + 1
            && incoming().dailyScansUsed == prevDailyUsed
          )
        );
    }

    function isValidSubscriptionRequest(data, requestId) {
      return data.keys().hasAll([
          'id', 'userId', 'userName', 'userEmail', 'planId', 'planName',
          'durationDays', 'priceBdt', 'priceUsdt', 'paymentMethod', 'senderNumber',
          'trxId', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'userName', 'userEmail', 'userPhone', 'planId', 'planName',
          'durationDays', 'dailyScanLimit', 'priceBdt', 'priceUsdt', 'paymentMethod',
          'senderNumber', 'trxId', 'status', 'reviewedBy', 'notes', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == requestId
        && isValidId(data.userId)
        && data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 100
        && data.userEmail is string && data.userEmail.size() >= 3 && data.userEmail.size() <= 200
        && (!('userPhone' in data) || (data.userPhone is string && data.userPhone.size() <= 30))
        && data.planId is string && data.planId.size() >= 1 && data.planId.size() <= 50
        && data.planName is string && data.planName.size() >= 1 && data.planName.size() <= 120
        && data.durationDays is number && data.durationDays > 0 && data.durationDays <= 36500
        && (!('dailyScanLimit' in data) || (data.dailyScanLimit is number && data.dailyScanLimit >= 0 && data.dailyScanLimit <= 100000))
        && data.priceBdt is number && data.priceBdt >= 0
        && data.priceUsdt is number && data.priceUsdt >= 0
        && data.paymentMethod in ['bkash', 'nagad', 'rocket', 'binance']
        && data.senderNumber is string && data.senderNumber.size() >= 3 && data.senderNumber.size() <= 80
        && data.trxId is string && data.trxId.size() >= 3 && data.trxId.size() <= 100
        && data.status in ['PENDING', 'APPROVED', 'REJECTED']
        && (!('reviewedBy' in data) || (data.reviewedBy is string && data.reviewedBy.size() <= 200))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 300))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPaymentConfig(data) {
      return data.keys().hasAll([
          'bkashNumber', 'bkashType', 'nagadNumber', 'nagadType',
          'rocketNumber', 'binanceUsdtAddress', 'binanceNetwork', 'instructionBn', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'bkashNumber', 'bkashType', 'nagadNumber', 'nagadType',
          'rocketNumber', 'binanceUsdtAddress', 'binanceNetwork', 'instructionBn', 'updatedAt'
        ])
        && data.bkashNumber is string && data.bkashNumber.size() <= 40
        && data.bkashType is string && data.bkashType.size() <= 60
        && data.nagadNumber is string && data.nagadNumber.size() <= 40
        && data.nagadType is string && data.nagadType.size() <= 60
        && data.rocketNumber is string && data.rocketNumber.size() <= 40
        && data.binanceUsdtAddress is string && data.binanceUsdtAddress.size() <= 150
        && data.binanceNetwork is string && data.binanceNetwork.size() <= 80
        && data.instructionBn is string && data.instructionBn.size() <= 500
        && data.updatedAt is timestamp;
    }

    function isValidPlanSettings(data) {
      return data.keys().hasAll([
          'freeTrialScans',
          'trial7dName', 'trial7dDays', 'trial7dDailyLimit', 'trial7dPriceBdt', 'trial7dPriceUsdt',
          'monthly1mName', 'monthly1mDays', 'monthly1mDailyLimit', 'monthly1mPriceBdt', 'monthly1mPriceUsdt',
          'vip6mName', 'vip6mDays', 'vip6mDailyLimit', 'vip6mPriceBdt', 'vip6mPriceUsdt',
          'lifetimeName', 'lifetimeDays', 'lifetimeDailyLimit', 'lifetimePriceBdt', 'lifetimePriceUsdt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'freeTrialScans',
          'trial7dName', 'trial7dDays', 'trial7dDailyLimit', 'trial7dPriceBdt', 'trial7dPriceUsdt',
          'monthly1mName', 'monthly1mDays', 'monthly1mDailyLimit', 'monthly1mPriceBdt', 'monthly1mPriceUsdt',
          'vip6mName', 'vip6mDays', 'vip6mDailyLimit', 'vip6mPriceBdt', 'vip6mPriceUsdt',
          'lifetimeName', 'lifetimeDays', 'lifetimeDailyLimit', 'lifetimePriceBdt', 'lifetimePriceUsdt',
          'updatedAt'
        ])
        && data.freeTrialScans is number && data.freeTrialScans >= 0 && data.freeTrialScans <= 1000
        && data.trial7dName is string && data.trial7dName.size() >= 1 && data.trial7dName.size() <= 120
        && data.trial7dDays is number && data.trial7dDays >= 1 && data.trial7dDays <= 36500
        && data.trial7dDailyLimit is number && data.trial7dDailyLimit >= 0 && data.trial7dDailyLimit <= 100000
        && data.trial7dPriceBdt is number && data.trial7dPriceBdt >= 0
        && data.trial7dPriceUsdt is number && data.trial7dPriceUsdt >= 0
        && data.monthly1mName is string && data.monthly1mName.size() >= 1 && data.monthly1mName.size() <= 120
        && data.monthly1mDays is number && data.monthly1mDays >= 1 && data.monthly1mDays <= 36500
        && data.monthly1mDailyLimit is number && data.monthly1mDailyLimit >= 0 && data.monthly1mDailyLimit <= 100000
        && data.monthly1mPriceBdt is number && data.monthly1mPriceBdt >= 0
        && data.monthly1mPriceUsdt is number && data.monthly1mPriceUsdt >= 0
        && data.vip6mName is string && data.vip6mName.size() >= 1 && data.vip6mName.size() <= 120
        && data.vip6mDays is number && data.vip6mDays >= 1 && data.vip6mDays <= 36500
        && data.vip6mDailyLimit is number && data.vip6mDailyLimit >= 0 && data.vip6mDailyLimit <= 100000
        && data.vip6mPriceBdt is number && data.vip6mPriceBdt >= 0
        && data.vip6mPriceUsdt is number && data.vip6mPriceUsdt >= 0
        && data.lifetimeName is string && data.lifetimeName.size() >= 1 && data.lifetimeName.size() <= 120
        && data.lifetimeDays is number && data.lifetimeDays >= 1 && data.lifetimeDays <= 36500
        && data.lifetimeDailyLimit is number && data.lifetimeDailyLimit >= 0 && data.lifetimeDailyLimit <= 100000
        && data.lifetimePriceBdt is number && data.lifetimePriceBdt >= 0
        && data.lifetimePriceUsdt is number && data.lifetimePriceUsdt >= 0
        && data.updatedAt is timestamp;
    }

    function isValidAdminMarker(data) {
      return data.keys().hasAll(['email', 'createdAt'])
        && data.keys().hasOnly(['email', 'createdAt'])
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.createdAt is timestamp;
    }

    function isValidApiEndpoint(data, endpointId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'name', 'category', 'method',
          'url', 'enabled', 'timeoutMs', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'name', 'category', 'method', 'url',
          'baseUrl', 'description', 'enabled', 'timeoutMs',
          'sampleBody', 'isCustom', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == endpointId
        && isValidId(data.ownerId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.category in ['MARKET_DATA', 'BACKEND_AI', 'AUTH_CLOUD', 'NOTIFICATIONS', 'CUSTOM']
        && data.method in ['GET', 'POST', 'PUT', 'DELETE', 'CLOUD']
        && data.url is string && data.url.size() >= 1 && data.url.size() <= 500
        && (!('baseUrl' in data) || (data.baseUrl is string && data.baseUrl.size() <= 300))
        && (!('description' in data) || (data.description is string && data.description.size() <= 500))
        && data.enabled is bool
        && data.timeoutMs is number && data.timeoutMs >= 500 && data.timeoutMs <= 120000
        && (!('sampleBody' in data) || (data.sampleBody is string && data.sampleBody.size() <= 2000))
        && (!('isCustom' in data) || data.isCustom is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 4. Collection Rules

    // Users collection (PII strictly restricted to owner or admin)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUser(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            incoming().role == 'user'
            && incoming().accountStatus == 'active'
            && incoming().subscriptionStatus == 'NONE'
            && incoming().expiresAt == 0
            && (!('freeScansUsed' in incoming()) || incoming().freeScansUsed == 0)
            && (!('dailyScansUsed' in incoming()) || incoming().dailyScansUsed == 0)
            && (!('totalScansUsed' in incoming()) || incoming().totalScansUsed == 0)
            && (!('freeScansLimit' in incoming()) || (
              exists(/databases/$(database)/documents/planSettings/default)
                ? incoming().freeScansLimit == get(/databases/$(database)/documents/planSettings/default).data.freeTrialScans
                : (incoming().freeScansLimit >= 0 && incoming().freeScansLimit <= 5)
            ))
          )
        );

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidUser(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(userId)
            && incoming().role == existing().role
            && incoming().accountStatus == existing().accountStatus
            && incoming().expiresAt == existing().expiresAt
            && ((!('freeScansLimit' in incoming()) && !('freeScansLimit' in existing())) || (('freeScansLimit' in incoming()) && ('freeScansLimit' in existing()) && incoming().freeScansLimit == existing().freeScansLimit))
            && ((!('customDailyScanLimit' in incoming()) && !('customDailyScanLimit' in existing())) || (('customDailyScanLimit' in incoming()) && ('customDailyScanLimit' in existing()) && incoming().customDailyScanLimit == existing().customDailyScanLimit))
            && ((!('dailyScanLimit' in incoming()) && !('dailyScanLimit' in existing())) || (('dailyScanLimit' in incoming()) && ('dailyScanLimit' in existing()) && incoming().dailyScanLimit == existing().dailyScanLimit))
            && (
              incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'photoURL', 'updatedAt']) ||
              (
                incoming().subscriptionStatus == 'PENDING'
                && incoming().diff(existing()).affectedKeys().hasOnly([
                  'subscriptionStatus', 'planId', 'planName', 'paymentMethod',
                  'senderNumber', 'trxId', 'requestedAt', 'updatedAt'
                ])
              ) ||
              isValidUserScanIncrement()
            )
          )
        );

      allow delete: if isAdmin() && isValidId(userId);
    }

    // Subscription Requests collection
    match /subscriptionRequests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isVerifiedUser()
        && isValidId(requestId)
        && isValidSubscriptionRequest(incoming(), requestId)
        && incoming().userId == request.auth.uid
        && incoming().status == 'PENDING'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(requestId)
        && isValidSubscriptionRequest(incoming(), requestId)
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (existing().status == 'PENDING' || isAdmin())
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewedBy', 'notes', 'updatedAt']);

      allow delete: if isAdmin() && isValidId(requestId);
    }

    // Payment Gateway Config collection
    match /paymentConfig/{configId} {
      allow get: if isSignedIn() && isValidId(configId);
      allow list: if false;

      allow create: if isAdmin()
        && isValidId(configId)
        && isValidPaymentConfig(incoming())
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(configId)
        && isValidPaymentConfig(incoming())
        && incoming().updatedAt == request.time;

      allow delete: if false;
    }

    // Plan & Scan Quota Config collection
    match /planSettings/{configId} {
      allow get: if isSignedIn() && isValidId(configId);
      allow list: if false;

      allow create: if isAdmin()
        && isValidId(configId)
        && isValidPlanSettings(incoming())
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(configId)
        && isValidPlanSettings(incoming())
        && incoming().updatedAt == request.time;

      allow delete: if false;
    }

    // Admin Role Marker collection
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if isAdmin();

      allow create: if isAdmin()
        && isValidId(adminId)
        && isValidAdminMarker(incoming())
        && incoming().createdAt == request.time;

      allow update: if false;
      allow delete: if isAdmin() && isValidId(adminId);
    }

    // API Endpoints Registry collection
    match /apiEndpoints/{endpointId} {
      allow get: if isSignedIn() && isValidId(endpointId) && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);

      allow create: if isVerifiedUser()
        && isValidId(endpointId)
        && isValidApiEndpoint(incoming(), endpointId)
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(endpointId)
        && isValidApiEndpoint(incoming(), endpointId)
        && (existing().ownerId == request.auth.uid || isAdmin())
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'category', 'method', 'url', 'baseUrl',
          'description', 'enabled', 'timeoutMs', 'sampleBody', 'updatedAt'
        ]);

      allow delete: if isVerifiedUser()
        && isValidId(endpointId)
        && (existing().ownerId == request.auth.uid || isAdmin());
    }
  }
}
